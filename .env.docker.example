# Environment for the Docker deployment.
#
#   cp .env.docker.example .env
#   php artisan key:generate --show        # paste into APP_KEY below
#
# `docker compose` reads this file for ${VAR} interpolation AND passes it into
# the containers. The image itself ships without a .env on purpose — secrets
# belong to the deployment, not to the build.

APP_NAME=TarpaLink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# A due date of 5 PM must mean 5 PM in the shop's calendar, not 1 AM the next
# day in UTC. DB_TIMEZONE must stay in step with APP_TIMEZONE for MySQL TIMESTAMPs.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

# Port on the host that nginx is published on.
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr so `docker compose logs` is the only place to look.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL runs in the `db` service. These must match the db service's env.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tarpalink
DB_USERNAME=tarpalink
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Database-backed session, cache and queue: no Redis to run, and the worker
# reads the same queue the web process writes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tarpalink.ph"
MAIL_FROM_NAME="${APP_NAME}"

# PayMongo. PAYMONGO_WEBHOOK_SECRET is required in production: without it the
# webhook endpoint rejects every request rather than trusting anything.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Inbound mail. Both are required for replies to reach a job: the address is
# what outbound mail puts in Reply-To (tagged with the job reference), and the
# secret is what signs the forwarded body. With either empty, notifications go
# out with no Reply-To and the webhook refuses everything — both deliberately,
# so a half-configured deployment fails closed.
INBOUND_ADDRESS=
INBOUND_SECRET=

# Address lookup. The container needs outbound HTTPS to reach Nominatim; set
# this to false if it has none, or the address box waits for a timeout.
GEOCODER_ENABLED=true
GEOCODER_COUNTRY=ph
GEOCODER_TIMEOUT=6

# The first administrator, created by:
#   docker compose exec app php artisan db:seed --class=ProductionSeeder --force
# Leave unset and the seeder creates no user rather than inventing a password.
# Quote any value containing a space — dotenv cannot parse `ADMIN_NAME=Ops Lead`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Ops Lead"

VITE_APP_NAME="${APP_NAME}"
