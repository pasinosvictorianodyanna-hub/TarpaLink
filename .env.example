APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Shops and customers are in the Philippines. Keep this in step with DB_TIMEZONE.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where proof artwork lives. `local` keeps files inside the container, which is
# lost on every rebuild — fine for a demo, not for real artwork. Set this to `s3`
# (with the AWS_* values above) before a shop uploads anything it needs back.
PROOF_DISK_DRIVER=local
# Only set this to move the local root; leave it out to use storage/app/private.
# PROOF_DISK_ROOT=

VITE_APP_NAME="${APP_NAME}"

# PayMongo (sandbox only). Leave PAYMONGO_SECRET_KEY empty to run in simulated
# mode: intents are generated locally and the webhook accepts unsigned events,
# but only outside production.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# What the processor is assumed to take, until it reports the real fee on the
# settled payment. Basis points plus a flat centavo amount: 250 + 1500 is
# 2.5% + P15. The shop bears this, so the payout screen labels any row still
# carrying the estimate with "est.".
PAYMONGO_FEE_RATE_BP=250
PAYMONGO_FEE_FLAT=1500

# Address lookup, through OpenStreetMap's Nominatim. No key needed; set
# GEOCODER_ENABLED=false to switch the address box off entirely, which is what
# you want on a machine with no route out — otherwise it waits for a timeout.
GEOCODER_ENABLED=true
GEOCODER_COUNTRY=ph
GEOCODER_TIMEOUT=6

# Inbound mail. INBOUND_ADDRESS is the mailbox your provider forwards to us;
# every notification carries reply+<job reference>@ on it, so a customer hitting
# Reply files their answer on the right job. Leave it empty and no Reply-To is
# set at all — better than pointing replies at a mailbox nobody reads.
# INBOUND_SECRET signs the forwarded body; with no secret the webhook refuses
# everything rather than accepting unsigned history from anyone who finds it.
INBOUND_ADDRESS=
INBOUND_SECRET=
# INBOUND_MAX_BODY=20000
