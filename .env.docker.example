# Environment for the Docker deployment.
#
#   cp .env.docker.example .env
#   php artisan key:generate --show        # paste into APP_KEY below
#
# `docker compose` reads this file for ${VAR} interpolation AND passes it into
# the containers. The image itself ships without a .env on purpose — secrets
# belong to the deployment, not to the build.

APP_NAME=TarpaLink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# A due date of 5 PM must mean 5 PM in the shop's calendar, not 1 AM the next
# day in UTC. DB_TIMEZONE must stay in step with APP_TIMEZONE for MySQL TIMESTAMPs.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

# Port on the host that nginx is published on.
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Behind a TLS terminator (Cloudflare, an ALB, a second nginx), nginx is not the
# edge and PHP never sees the original scheme — so every generated URL comes out
# http://. That breaks proof links, password resets and invitations in exactly the
# way the loopback-invitation bug did. Set this to the proxy's address or subnet;
# `*` trusts anything and is only safe when nothing else can reach the container.
# Leave empty when nginx is the edge, which is the default `docker compose` setup.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# stderr so `docker compose logs` is the only place to look.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL runs in the `db` service. These must match the db service's env.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tarpalink
DB_USERNAME=tarpalink
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# A database that signs with its own CA — TiDB Cloud does — needs PDO pointed at
# a certificate *file*, which is awkward anywhere the environment can only hold
# a string. Set DB_SSL_CA_PEM to the certificate's contents and the container
# writes it to /etc/ssl/certs/db-ca.pem and exports MYSQL_ATTR_SSL_CA for you;
# set MYSQL_ATTR_SSL_CA directly if the file is already mounted. The second
# always wins, so leaving a stale DB_SSL_CA_PEM behind cannot override a mount.
# DB_SSL_CA_PEM=
# MYSQL_ATTR_SSL_CA=
# The CA alone also turns on the peer-name check, which a certificate with no
# SAN cannot pass — MySQL's own auto-generated one has none. Set this to false
# to keep the encryption and drop the name check; leave it blank otherwise,
# because a blank value is treated as unset, not as false.
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=

# Database-backed session, cache and queue: no Redis to run, and the worker
# reads the same queue the web process writes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Proof artwork. The default is the container's own disk, which is lost on the
# next rebuild — set this to `s3` before a shop uploads anything it needs back.
# The object keys stay `proofs/...`, so nothing in the database changes when you
# switch, and PROOF_DISK_ROOT only applies to the `local` driver.
PROOF_DISK_DRIVER=local
# PROOF_DISK_ROOT=

# Customer artwork — the files customers send to be printed. Left unset these
# follow the two PROOF_DISK_* settings above, so moving to object storage moves
# both in one edit. Set ARTWORK_DISK_DRIVER only to keep them apart (a shop may
# want artwork on cheaper storage than the proofs it has to keep).
# ARTWORK_DISK_DRIVER=
# ARTWORK_DISK_ROOT=

# Only read when PROOF_DISK_DRIVER=s3. The bucket needs to exist; the app does
# not create it. Endpoint is optional and is what points this at R2, Spaces or
# MinIO instead of AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tarpalink.ph"
MAIL_FROM_NAME="${APP_NAME}"

# `log` writes mail to storage/logs and sends nothing. Proof notifications,
# receipts and invitations all go through the same mailer, so a real deployment
# sets the four lines below and changes MAIL_MAILER to `smtp`. For Gmail that is
# smtp.gmail.com:587 with an App Password — not the account password, which is
# rejected.
# MAIL_SCHEME=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# PayMongo. PAYMONGO_WEBHOOK_SECRET is required in production: without it the
# webhook endpoint rejects every request rather than trusting anything.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Inbound mail. Both are required for replies to reach a job: the address is
# what outbound mail puts in Reply-To (tagged with the job reference), and the
# secret is what signs the forwarded body. With either empty, notifications go
# out with no Reply-To and the webhook refuses everything — both deliberately,
# so a half-configured deployment fails closed.
INBOUND_ADDRESS=
INBOUND_SECRET=

# Address lookup. The container needs outbound HTTPS to reach Nominatim; set
# this to false if it has none, or the address box waits for a timeout.
GEOCODER_ENABLED=true
GEOCODER_COUNTRY=ph
GEOCODER_TIMEOUT=6

# The first administrator, created by:
#   docker compose exec app php artisan db:seed --class=ProductionSeeder --force
# Leave unset and the seeder creates no user rather than inventing a password.
# Quote any value containing a space — dotenv cannot parse `ADMIN_NAME=Ops Lead`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Ops Lead"

VITE_APP_NAME="${APP_NAME}"
